{
  "name": "visa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Visa Automation SaaS Platform - TypeScript Monorepo",
  "workspaces": [
    "apps/cp",
    "apps/dp",
    "apps/web/*",
    "packages/*",
    "tests/e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:staff": "npm run dev --workspace=@visa-automation/staff-portal",
    "dev:mock": "npm run dev --workspace=@visa-automation/mock-portal",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "./scripts/db/migrate.sh",
    "db:seed": "./scripts/db/seed.sh",
    "docker:up": "cd infra/docker/dev && cp -n .env.dev.example .env.dev 2>/dev/null; docker compose --env-file .env.dev -f compose.yml -f dev-override.yml up -d --build --pull=never",
    "docker:down": "cd infra/docker/dev && docker compose --env-file .env.dev -f compose.yml -f dev-override.yml down",
    "docker:logs": "cd infra/docker/dev && docker compose --env-file .env.dev -f compose.yml -f dev-override.yml logs -f",
    "docker:up:prod": "cd infra/docker/prod && ./up.sh",
    "dev:cp": "npm run dev --workspace=@visa-automation/cp",
    "dev:dp": "npm run dev --workspace=@visa-automation/dp",
    "dev:admin-portal": "npm run dev --workspace=@visa-automation/admin-portal",
    "e2e": "npm run e2e --workspace=visa-automation-e2e"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "typescript-eslint": "^8.29.0",
    "puppeteer": "^24.37.3",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}