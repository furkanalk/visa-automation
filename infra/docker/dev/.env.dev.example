# =============================================================================
# Dev – copy to .env in this folder:  cp .env.dev.example .env.dev
# Run from infra/docker/dev:  ./up.sh   or   docker compose -f compose.yml -f dev-override.yml up -d
# See docs/REFERENCE.md
# =============================================================================

# --- Bootstrap super_admin (first-time setup) ---
# This account is created once on first boot and is hidden from the staff list.
# Set a strong password and keep it safe — this is your master admin account.
# Leave blank to skip creating a bootstrap admin.
BOOTSTRAP_ADMIN_EMAIL=superadmin@vizeself.local
BOOTSTRAP_ADMIN_PASSWORD=Vizeself2026!
BOOTSTRAP_ADMIN_NAME=System Administrator

# --- Docker build (optional; ./up.sh sets this for faster npm cache) ---
# When running 'docker compose ... up --build' manually, export first:  export DOCKER_BUILDKIT=1
DOCKER_BUILDKIT=1

# --- Database (required; no in-app defaults) ---
# Compose: postgres. Local: localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=visa_automation
DB_USER=postgres
DB_PASSWORD=postgres

# --- Redis (required; no in-app defaults) ---
# Compose: redis. Local: localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- App ---
LOG_LEVEL=debug
CORS_ORIGIN=*

# --- Worker / DP identity (required) ---
WORKER_ID=worker-1
TENANT_ID=default

# --- DP only: API URLs (required) ---
CP_API_URL=http://cp:3001
PUBLIC_API_URL=http://cp:3001

# --- Notify ---
# Telegram/SMTP and notify_action_* are in CP (Admin → Notify, Admin → Settings).
# DP calls GET /cp/notify/worker with this secret; same value in CP and DP.
CP_INTERNAL_SECRET=64305d6aafef3b6745688df5621a9d702d39116b859cfa8f7f1f390530faba63

# --- Frontends (browser) ---
NEXT_PUBLIC_CP_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Note: Admin Portal URL for invite emails is set in Admin Portal → Settings → API Configuration.
# Mock portal URL is set via USE_MOCK_PORTAL env below (DP reads it from env, not DB).

# --- Mock portal (DP) ---
USE_MOCK_PORTAL=true
# Base host only — each portal appends its own id (e.g. http://mock-portal:3004 → .../as-visa, .../example-site, ...)
# Add new portals in Admin → Portals; no env change needed.
MOCK_PORTAL_BASE_URL=http://mock-portal:3004

# --- Docker image names (dev: built locally) ---
IMAGE_CP=visa-automation/cp:latest
IMAGE_DP=visa-automation/dp:latest
IMAGE_ADMIN_PORTAL=visa-automation/admin-portal:latest
IMAGE_STAFF_PORTAL=visa-automation/staff-portal:latest
IMAGE_MOCK_PORTAL=visa-automation/mock-portal:latest
