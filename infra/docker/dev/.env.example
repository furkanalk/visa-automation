# =============================================================================
# Dev – copy to .env in this folder.
# Run: docker compose up -d
# Local run from repo root: copy to root .env, set
#   DB_HOST=localhost REDIS_HOST=localhost
#   CP_API_URL=http://localhost:3001 PUBLIC_API_URL=http://localhost:3000
#   TENANT_ID=default
# See docs/REFERENCE.md
# =============================================================================

# --- Database (required; no in-app defaults) ---
# Compose: postgres. Local: localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=visa_automation
DB_USER=postgres
DB_PASSWORD=postgres

# --- Redis (required; no in-app defaults) ---
# Compose: redis. Local: localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- App ---
LOG_LEVEL=debug
CORS_ORIGIN=*

# --- Worker / DP identity (required) ---
# Agent counts and intervals come from Postgres (migration 010); edit in Admin → Settings.
WORKER_ID=worker-1
TENANT_ID=default

# --- DP only: API URLs (required) ---
CP_API_URL=http://cp:3001
PUBLIC_API_URL=http://cp:3001

# --- Notify ---
# Telegram/SMTP and notify_action_* are in CP (Admin → Notify, Admin → Settings).
# DP calls GET /cp/notify/worker with this secret; same value in CP and DP.
CP_INTERNAL_SECRET=changeme

# --- Frontends (browser) ---
NEXT_PUBLIC_CP_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Mock portal (DP) ---
USE_MOCK_PORTAL=true
MOCK_PORTAL_URL=http://mock-portal:3004/as-visa
