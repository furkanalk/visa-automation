# =============================================================================
# Test (CI / local E2E) – copy to .env in this folder.
# See docs/REFERENCE.md
# =============================================================================

# --- Database (required; no in-app defaults) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=visa_automation_test
DB_USER=postgres
DB_PASSWORD=postgres_test_secret

# --- Redis (required; no in-app defaults) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- App ---
LOG_LEVEL=info
CORS_ORIGIN=*

# --- Worker / DP identity (required) ---
# Agent counts and intervals come from Postgres (migration 010); edit in Admin → Settings.
WORKER_ID=worker-1
TENANT_ID=default

# --- DP only: API URLs (required) ---
CP_API_URL=http://cp:3001
PUBLIC_API_URL=http://cp:3001

# --- Notify ---
# Telegram/SMTP and notify_action_* are in CP. DP uses this secret for /cp/notify/worker.
CP_INTERNAL_SECRET=test-internal-secret

# --- Frontends (browser; CI uses hostname cp) ---
NEXT_PUBLIC_CP_API_URL=http://cp:3001
NEXT_PUBLIC_API_URL=http://cp:3001

# --- Mock portal (DP) ---
USE_MOCK_PORTAL=true
MOCK_PORTAL_URL=http://mock-portal:3004/as-visa
