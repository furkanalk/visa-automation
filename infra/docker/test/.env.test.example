# =============================================================================
# Test (CI / local E2E) – copy to .env in this folder:  cp .env.test.example .env.test
# Run from infra/docker/test:  ./up.sh   or   docker compose -f compose.yml -f test-override.yml up -d
# See docs/REFERENCE.md
# =============================================================================

# --- Docker build (optional; for CI/local builds) ---
DOCKER_BUILDKIT=1

# --- Bootstrap super_admin ---
BOOTSTRAP_ADMIN_EMAIL=superadmin@test.local
BOOTSTRAP_ADMIN_PASSWORD=TestAdmin123!
BOOTSTRAP_ADMIN_NAME=System Administrator

# --- Database (required; no in-app defaults) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=visa_automation_test
DB_USER=postgres
DB_PASSWORD=postgres_test_secret

# --- Redis (required; no in-app defaults) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- App ---
LOG_LEVEL=info
CORS_ORIGIN=*

# --- Worker / DP identity (required) ---
WORKER_ID=worker-1
TENANT_ID=default

# --- DP only: API URLs (required) ---
CP_API_URL=http://cp:3001
PUBLIC_API_URL=http://cp:3001

# --- Notify ---
# Telegram/SMTP and notify_action_* are in CP. DP uses this secret for /cp/notify/worker.
CP_INTERNAL_SECRET=test-internal-secret

# --- Frontends (browser; CI uses hostname cp) ---
NEXT_PUBLIC_CP_API_URL=http://cp:3001
NEXT_PUBLIC_API_URL=http://cp:3001

# --- Mock portal (DP) ---
USE_MOCK_PORTAL=true
# Base host only — each portal appends its own id (e.g. http://mock-portal:3004 → .../as-visa, .../example-site, ...)
# Add new portals in Admin → Portals; no env change needed.
MOCK_PORTAL_BASE_URL=http://mock-portal:3004

# --- Docker image names (test: built in CI or locally) ---
IMAGE_CP=visa-automation/cp:latest
IMAGE_DP=visa-automation/dp:latest
IMAGE_ADMIN_PORTAL=visa-automation/admin-portal:latest
IMAGE_STAFF_PORTAL=visa-automation/staff-portal:latest
IMAGE_MOCK_PORTAL=visa-automation/mock-portal:latest
