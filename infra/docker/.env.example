# Visa Automation Environment Variables
# Copy this file to .env and customize as needed

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=visa_automation
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# API Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=2

# Kong (if using external)
KONG_ADMIN_URL=http://localhost:8001
