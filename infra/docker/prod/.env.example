# =============================================================================
# Production – copy to .env in this folder and set strong secrets.
# See docs/REFERENCE.md
# =============================================================================

# --- Database (required; no in-app defaults) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=visa_automation
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Optional: Postgres mTLS (docs/REFERENCE.md)
# DB_SSL_CA_PATH=/path/to/ca.pem
# DB_SSL_CERT_PATH=/path/to/client.crt
# DB_SSL_KEY_PATH=/path/to/client.key
# DB_SSL=verify-full

# --- Redis (required; no in-app defaults) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- App ---
LOG_LEVEL=info
CORS_ORIGIN=https://your-admin-domain.com

# --- Worker / DP identity (required) ---
# Agent counts and intervals come from Postgres (migration 010); edit in Admin → Settings.
WORKER_ID=worker-1
TENANT_ID=default

# --- DP only: API URLs (required) ---
CP_API_URL=https://api.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com

# --- Notify ---
# Telegram/SMTP and notify_action_* are in CP (Admin → Notify, Admin → Settings).
# DP calls GET /cp/notify/worker with this secret; same value in CP and DP. Do not commit.
CP_INTERNAL_SECRET=CHANGE_ME
# Generate: openssl rand -base64 32

# --- Frontends (public URLs) ---
NEXT_PUBLIC_CP_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# --- Mock portal (DP) ---
USE_MOCK_PORTAL=false
