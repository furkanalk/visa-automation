# Visa Automation Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=visa_automation

# ===========================================
# Redis Configuration (BullMQ Job Queue)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# Application Configuration
# ===========================================
LOG_LEVEL=info

# ===========================================
# Worker AgentPool Configuration
# ===========================================
# Worker identity (unique per worker instance)
WORKER_ID=worker-1

# Tenant ID for this worker's agents
TENANT_ID=default

# Control Plane API URL (internal)
CP_API_URL=http://localhost:3001

# Public API URL (for job status checks)
# This should be the externally accessible API endpoint
PUBLIC_API_URL=http://localhost:3000

# Number of async agents (poll queue for jobs)
ASYNC_AGENT_COUNT=2

# Number of sync agents (manually triggered via CP)
SYNC_AGENT_COUNT=0

# Heartbeat interval in milliseconds (default: 10s)
HEARTBEAT_INTERVAL_MS=10000

# Config refresh interval in milliseconds (default: 60s)
CONFIG_REFRESH_INTERVAL_MS=60000

# Sync agent poll interval in milliseconds (default: 5s)
SYNC_POLL_INTERVAL_MS=5000

# Maximum agents this worker can manage
MAX_AGENTS=100

# ===========================================
# Telegram Notifications (Required for worker)
# ===========================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated list of chat IDs (channels, groups, or private chats)
# Get chat ID by sending a message and calling: https://api.telegram.org/bot<TOKEN>/getUpdates
# Example: -1001234567890,-1009876543210
TELEGRAM_CHAT_IDS=

# Base URL for action button links (should point to your API/Kong gateway)
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
# Currently proxy is 3000 until gateway deployed, then switch to 8000
NOTIFY_ACTION_BASE_URL=http://localhost:3000

# Secret token for notification action links (MVP)
# Generate: openssl rand -base64 32
# Required for both API and Worker
NOTIFY_ACTION_TOKEN=

# ===========================================
# Email Notifications (SMTP)
# ===========================================
# SMTP server configuration for sending email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Visa Automation <no-reply@yourdomain.com>"

# applicant email yoksa buraya gönder
SMTP_FALLBACK_TO=

# ops/test override (opsiyonel)
# NOTIFY_EMAIL_TO=dev@yourdomain.com

# ===========================================
# Admin UI (apps/admin-ui) - Port 3002
# ===========================================
NEXT_PUBLIC_CP_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# ===========================================
# Staff Portal (apps/staff-portal) - Port 3003
# ===========================================
# Staff Portal uses the same API URLs as Admin UI
# These are prefixed with NEXT_PUBLIC_ so they're available in the browser
# Note: Staff Portal reads from the same env vars (NEXT_PUBLIC_CP_API_URL)
# or can be overridden via localStorage in the Settings page
