# Visa Automation Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration
# ===========================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=visa_automation

# ===========================================
# Application Configuration
# ===========================================
LOG_LEVEL=info
WORKER_CONCURRENCY=2

# ===========================================
# Telegram Notifications (Required for worker)
# ===========================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated list of chat IDs (channels, groups, or private chats)
# Get chat ID by sending a message and calling: https://api.telegram.org/bot<TOKEN>/getUpdates
# Example: -1001234567890,-1009876543210
TELEGRAM_CHAT_IDS=

# Base URL for action button links (should point to your API/Kong gateway)
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
NOTIFY_ACTION_BASE_URL=http://localhost:8000

# Secret key for signing notification action links (HMAC-SHA256)
# Generate: openssl rand -base64 32
# Required for both API and Worker
NOTIFY_ACTION_SECRET=
